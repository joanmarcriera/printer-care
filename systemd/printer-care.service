[Unit]
Description=printer-care: update colour-page clock and print a keep-alive page if due
After=network-online.target cups.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/printer-care check
User=root
# Hardening: state lives in /var/lib/printer-care; everything else is read-only.
StateDirectory=printer-care
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
# lp talks to cupsd over its unix socket in /run/cups; connect() works on a read-only
# mount, so no ReadWritePaths is needed.
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
