diff --git a/scripts/stamp.py b/scripts/stamp.py
new file mode 100755
index 0000000..9e878fe
--- /dev/null
+++ b/scripts/stamp.py
@@ -0,0 +1,46 @@
+#!/usr/bin/env python3
+"""stamp.py - stamp the print date in the top-right corner of every page of a PDF.
+
+Usage: stamp.py IN.pdf OUT.pdf [YYYY-MM-DD]     (date defaults to today, local time)
+Needs pypdf and reportlab (both installed for the system python3 on Marc's Mac).
+Exit 0 ok, 2 bad input. Never prints anything; used by print.sh.
+"""
+import datetime as dt
+import io
+import sys
+
+from pypdf import PdfReader, PdfWriter
+from reportlab.pdfgen import canvas
+
+
+def main(argv):
+    if len(argv) not in (3, 4):
+        print(__doc__, file=sys.stderr)
+        return 2
+    src, dst = argv[1], argv[2]
+    text = argv[3] if len(argv) == 4 else dt.date.today().isoformat()
+    try:
+        reader = PdfReader(src)
+        writer = PdfWriter()
+        for src_page in reader.pages:
+            page = writer.add_page(src_page)          # attach first (pypdf >= 7), then edit
+            page.transfer_rotation_to_content()       # a /Rotate page would put the stamp on the wrong edge
+            x0, y0 = float(page.mediabox.left), float(page.mediabox.bottom)
+            w, h = float(page.mediabox.width), float(page.mediabox.height)
+            buf = io.BytesIO()
+            c = canvas.Canvas(buf, pagesize=(x0 + w, y0 + h))
+            c.setFont("Helvetica", 8)
+            c.drawRightString(x0 + w - 14 * 2.835, y0 + h - 7 * 2.835, text)   # 14 mm from right, 7 mm from top
+            c.save()
+            buf.seek(0)
+            page.merge_page(PdfReader(buf).pages[0])
+        with open(dst, "wb") as f:
+            writer.write(f)
+    except Exception as e:  # unreadable or encrypted PDF
+        print(f"stamp.py: {type(e).__name__}: {e}", file=sys.stderr)
+        return 2
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv))
